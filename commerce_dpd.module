function commerce_dpd_entity_operation(EntityInterface $entity) {
  $operations = [];
  // Only for placed orders.
  if ($entity instanceof OrderInterface && $entity->getState()->getId() === 'validation') {
    // Check if it's a DPD order.
    $is_dpd_order = FALSE;
    if ($entity->hasField('shipments') && !$entity->get('shipments')->isEmpty()) {
      foreach ($entity->get('shipments')->referencedEntities() as $shipment) {
        $shipping_method = $shipment->getShippingMethod();
        if ($shipping_method && strpos($shipping_method->getPlugin()->getPluginId(), 'dpd') !== FALSE) {
          $is_dpd_order = TRUE;
          break;
        }
      }
    }
    if ($is_dpd_order) {
      $operations['generate_dpd_label'] = [
        'title' => t('Generate DPD Label'),
        'url' => Url::fromRoute('commerce_dpd.generate_label_now', [
          'commerce_order' => $entity->id()
        ]),
        'weight' => 10
      ];
    }
  }
  return $operations;
}

/**
 * Implements hook_theme().
 */
function commerce_dpd_theme($existing, $type, $theme, $path) {
  return [
    'dpd_parcelshop_option' => [
      'variables' => [
        'id' => NULL,
        'company' => '',
        'street' => '',
        'zip' => '',
        'city' => '',
        'distance' => 0,
        'extra_info' => [],
        'attributes' => NULL
      ],
      'template' => 'dpd-parcelshop-option'
    ],
    'dpd_map_popup' => [
      'variables' => [
        'shop' => NULL,
        'texts' => []
      ],
      'template' => 'dpd-map-popup'
    ]
  ];
}